{
    "name": "misty-butterfly-2711",
    "main": "src/index.js",
    "compatibility_date": "2026-08-11",
    "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "run_worker_first": [
            "/",
            "/login",
            "/register",
            "/dashboard",
            "/logout",
            "/tools/*"
        ]
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "login_db",
            "database_id": "a60e353c-2972-4b26-b298-1a0dd77727d6"
        }
    ]
}